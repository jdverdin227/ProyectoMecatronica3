@using Microsoft.AspNetCore.Identity
@inject UserManager<Proyecto.Models.User> UserManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Proyecto</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --sidebar-width: 270px;
            --sidebar-collapsed-width: 80px;
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --sidebar-bg: #111827;
            --sidebar-hover: #1f2937;
            --sidebar-text: #d1d5db;
            --sidebar-text-active: #ffffff;
            --background: #f3f4f6;
            --card: #ffffff;
            --border: #e5e7eb;
            --text: #111827;
            --muted: #6b7280;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: var(--background);
            color: var(--text);
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        .app {
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            transition: width .25s ease, transform .25s ease;
            overflow: hidden;
        }

        .sidebar-header {
            height: 76px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            gap: 13px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }

        .logo {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), #60a5fa);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(37,99,235,.3);
        }

        .brand {
            color: white;
            font-size: 18px;
            font-weight: 700;
            white-space: nowrap;
        }

        .brand small {
            display: block;
            font-size: 11px;
            font-weight: 400;
            color: #9ca3af;
            margin-top: 2px;
        }

        .sidebar-menu {
            flex: 1;
            padding: 18px 12px;
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .sidebar-menu::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-menu::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 10px;
        }

        .menu-section {
            margin-bottom: 24px;
        }

        .menu-title {
            padding: 0 12px 8px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6b7280;
            font-weight: 700;
        }

        .menu-item {
            margin-bottom: 4px;
        }

        .menu-link,
        .submenu-toggle {
            width: 100%;
            height: 46px;
            padding: 0 13px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            gap: 13px;
            color: var(--sidebar-text);
            font-size: 14px;
            font-weight: 500;
            border: 0;
            background: transparent;
            cursor: pointer;
            transition: .2s ease;
        }

        .menu-link i,
        .submenu-toggle i:first-child {
            width: 22px;
            min-width: 22px;
            text-align: center;
            font-size: 17px;
        }

        .menu-link:hover,
        .submenu-toggle:hover {
            background: var(--sidebar-hover);
            color: white;
        }

        .menu-link.active {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            box-shadow: 0 8px 20px rgba(37,99,235,.25);
        }

        .arrow {
            margin-left: auto;
            font-size: 13px !important;
            transition: transform .2s ease;
        }

        .submenu-toggle.open .arrow {
            transform: rotate(180deg);
        }

        .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height .25s ease;
            padding-left: 35px;
        }

        .submenu.open {
            max-height: 500px;
        }

        .submenu-link {
            display: flex;
            align-items: center;
            gap: 10px;
            height: 40px;
            padding: 0 13px;
            color: #9ca3af;
            font-size: 13px;
            border-radius: 8px;
            position: relative;
            transition: .2s ease;
        }

        .submenu-link::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #4b5563;
        }

        .submenu-link:hover {
            background: var(--sidebar-hover);
            color: white;
        }

        .submenu-link.active {
            color: #93c5fd;
        }

        .submenu-link.active::before {
            background: var(--primary);
        }

        /* USER */

        .sidebar-footer {
            padding: 12px;
            border-top: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }

        .user-box {
            padding: 10px;
            border-radius: 12px;
            background: rgba(255,255,255,.05);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #374151, #4b5563);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
        }

        .user-info {
            min-width: 0;
            flex: 1;
        }

        .user-name {
            color: white;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-role {
            color: #9ca3af;
            font-size: 11px;
            margin-top: 2px;
        }

        .logout-button {
            width: 34px;
            height: 34px;
            border: 0;
            background: transparent;
            color: #9ca3af;
            border-radius: 8px;
            cursor: pointer;
            transition: .2s;
        }

        .logout-button:hover {
            background: rgba(239,68,68,.15);
            color: #f87171;
        }

        /* MAIN */

        .main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin-left .25s ease;
        }

        .topbar {
            height: 76px;
            background: white;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .menu-button {
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            background: white;
            border-radius: 10px;
            color: #374151;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .menu-button:hover {
            background: #f9fafb;
        }

        .page-title h1 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text);
        }

        .page-title p {
            color: var(--muted);
            font-size: 12px;
            margin-top: 3px;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-icon {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            background: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4b5563;
            cursor: pointer;
            transition: .2s;
        }

        .topbar-icon:hover {
            background: #f9fafb;
            color: var(--primary);
        }

        .content {
            padding: 28px;
        }

        .content-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0,0,0,.03);
        }

        /* MOBILE */

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 999;
            opacity: 0;
            visibility: hidden;
            transition: .25s;
        }

        .sidebar-close {
            display: none;
            margin-left: auto;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #9ca3af;
            font-size: 18px;
            cursor: pointer;
        }

        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .sidebar-close {
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .main {
                margin-left: 0;
            }

            .overlay.show {
                opacity: 1;
                visibility: visible;
            }

            .topbar {
                padding: 0 18px;
            }

            .content {
                padding: 20px;
            }
        }

        @@media (max-width: 600px) {
            .page-title p {
                display: none;
            }

            .topbar-actions .optional {
                display: none;
            }

            .content {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <div class="app">

        <div class="overlay" id="overlay"></div>

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <div class="logo">
                    P
                </div>

                <div class="brand">
                    Proyecto
                    <small>Panel administrativo</small>
                </div>

                <button class="sidebar-close" id="sidebarClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <nav class="sidebar-menu">

                <div class="menu-section">

                    <div class="menu-title">
                        Principal
                    </div>

                    <div class="menu-item">
                        <a href="/Home/Index"
                           class="menu-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </div>

                    <div class="menu-item">
                        <button class="submenu-toggle">
                            <i class="bi bi-people-fill"></i>
                            <span>Usuarios</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </button>

                        <div class="submenu">
                            <a href="#" class="submenu-link">
                                Todos los usuarios
                            </a>

                            <a href="#" class="submenu-link">
                                Administradores
                            </a>

                            <a href="#" class="submenu-link">
                                Invitados
                            </a>
                        </div>
                    </div>

                </div>

                <div class="menu-section">

                    <div class="menu-title">
                        Gestión
                    </div>

                    <div class="menu-item">
                        <button class="submenu-toggle">
                            <i class="bi bi-box-seam-fill"></i>
                            <span>Productos</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </button>

                        <div class="submenu">
                            <a href="#" class="submenu-link">
                                Lista de productos
                            </a>

                            <a href="#" class="submenu-link">
                                Categorías
                            </a>

                            <a href="#" class="submenu-link">
                                Inventario
                            </a>
                        </div>
                    </div>

                    <div class="menu-item">
                        <button class="submenu-toggle">
                            <i class="bi bi-bar-chart-fill"></i>
                            <span>Reportes</span>
                            <i class="bi bi-chevron-down arrow"></i>
                        </button>

                        <div class="submenu">
                            <a href="#" class="submenu-link">
                                Ventas
                            </a>

                            <a href="#" class="submenu-link">
                                Usuarios
                            </a>

                            <a href="#" class="submenu-link">
                                Actividad
                            </a>
                        </div>
                    </div>

                </div>

                <div class="menu-section">

                    <div class="menu-title">
                        Sistema
                    </div>

                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-gear-fill"></i>
                            <span>Configuración</span>
                        </a>
                    </div>

                    <div class="menu-item">
                        <a href="#" class="menu-link">
                            <i class="bi bi-question-circle-fill"></i>
                            <span>Ayuda</span>
                        </a>
                    </div>

                </div>

            </nav>

            <div class="sidebar-footer">

                <div class="user-box">

                    <div class="user-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>

                    <div class="user-info">
                        <div class="user-name">
                            @(User.Identity?.Name ?? "Usuario")
                        </div>

                        <div class="user-role">
                            Sesión activa
                        </div>
                    </div>

                    <form action="/Auth/Logout" method="post">
                        <button type="submit"
                                class="logout-button"
                                title="Cerrar sesión">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>

                </div>

            </div>

        </aside>

        <main class="main">

            <header class="topbar">

                <div class="topbar-left">

                    <button class="menu-button" id="menuButton">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="page-title">
                        <h1>@ViewData["Title"]</h1>
                        <p>Panel de administración</p>
                    </div>

                </div>

                <div class="topbar-actions">

                    <button class="topbar-icon optional" title="Notificaciones">
                        <i class="bi bi-bell"></i>
                    </button>

                    <button class="topbar-icon" title="Perfil">
                        <i class="bi bi-person"></i>
                    </button>

                </div>

            </header>

            <section class="content">
                @RenderBody()
            </section>

        </main>

    </div>

    <script>
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("overlay");
        const menuButton = document.getElementById("menuButton");
        const sidebarClose = document.getElementById("sidebarClose");

        menuButton.addEventListener("click", () => {
            sidebar.classList.add("show");
            overlay.classList.add("show");
        });

        sidebarClose.addEventListener("click", () => {
            sidebar.classList.remove("show");
            overlay.classList.remove("show");
        });

        overlay.addEventListener("click", () => {
            sidebar.classList.remove("show");
            overlay.classList.remove("show");
        });

        document.querySelectorAll(".submenu-toggle").forEach(button => {

            button.addEventListener("click", () => {

                const submenu = button.nextElementSibling;
                const isOpen = submenu.classList.contains("open");

                document.querySelectorAll(".submenu").forEach(item => {
                    item.classList.remove("open");
                });

                document.querySelectorAll(".submenu-toggle").forEach(item => {
                    item.classList.remove("open");
                });

                if (!isOpen) {
                    submenu.classList.add("open");
                    button.classList.add("open");
                }
            });

        });

        document.querySelectorAll(".submenu-link").forEach(link => {

            link.addEventListener("click", () => {

                document.querySelectorAll(".submenu-link").forEach(item => {
                    item.classList.remove("active");
                });

                link.classList.add("active");
            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>